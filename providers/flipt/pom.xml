<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.openfeature.contrib</groupId>
        <artifactId>parent</artifactId>
        <version>[1.0,2.0)</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <groupId>dev.openfeature.contrib.providers</groupId>
    <artifactId>flipt</artifactId>
    <version>0.1.4</version> <!--x-release-please-version -->

    <name>flipt</name>
    <description>Flipt provider for Java</description>
    <url>https://www.flipt.io/</url>

    <properties>
        <javadoc.failOnWarnings>false</javadoc.failOnWarnings>
        <tck.version>[0.1.0,)</tck.version>
        <tck.testFailureIgnore>false</tck.testFailureIgnore>
        <flipt.tck.spec.version>v0.1.0</flipt.tck.spec.version>
        <flipt.tck.spec.url>https://github.com/flipt-io/openfeature-tck/archive/refs/tags/${flipt.tck.spec.version}.zip</flipt.tck.spec.url>
    </properties>

    <developers>
        <developer>
            <id>markphelps</id>
            <name>Mark Phelps</name>
            <organization>Flipt Software</organization>
            <url>https://flipt.io/</url>
        </developer>
    </developers>

    <dependencies>
        <dependency>
            <groupId>io.flipt</groupId>
            <artifactId>flipt-java</artifactId>
            <version>1.4.0</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.2.1</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.20</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.3</version>
        </dependency>

        <dependency>
            <groupId>dev.openfeature.contrib.tools</groupId>
            <artifactId>tck</artifactId>
            <version>${tck.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.26.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The Flipt vendor scenarios come from the shared testbed repository, not from
                 this one. The suite selects the classpath directory `extensions`, so the
                 downloaded feature files land in the test classpath under that name and run
                 beside the canonical scenarios. A missing file fails the build, because a
                 silent gap here would leave a green run with fewer scenarios. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>download-openfeature-tck</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="download.dir"
                                          value="${project.build.directory}/openfeature-tck"/>
                                <property name="features.dir"
                                          value="${project.build.testOutputDirectory}/extensions"/>

                                <delete dir="${download.dir}" quiet="true"/>
                                <delete dir="${features.dir}" quiet="true"/>

                                <mkdir dir="${download.dir}"/>
                                <mkdir dir="${features.dir}"/>

                                <get src="${flipt.tck.spec.url}"
                                     dest="${download.dir}/source.zip"
                                     usetimestamp="false"/>

                                <unzip src="${download.dir}/source.zip"
                                       dest="${download.dir}/extracted"/>

                                <copy todir="${features.dir}">
                                    <fileset dir="${download.dir}/extracted">
                                        <include name="**/*.feature"/>
                                    </fileset>
                                    <mapper type="flatten"/>
                                </copy>

                                <fail message="The Flipt vendor scenarios are missing from ${features.dir}. The archive at ${flipt.tck.spec.url} must contain extensions/flipt-reason.feature.">
                                    <condition>
                                        <not>
                                            <available file="${features.dir}/flipt-reason.feature"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
